[Unit]
Description=Pause NapCat after QQ forces the device offline
After=docker.service
Requires=docker.service
ConditionPathExists=!/opt/qq-cs/.napcat-risk-paused

[Service]
Type=simple
ExecStart=/bin/bash /opt/qq-cs/napcat-risk-guard.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
